#!/bin/sh
# nexus-ops-runner: the only program the GitHub "VPS operations" key can start on this server.
#
# Installed at /usr/local/sbin/nexus-ops-runner by setup-vps-ops.sh. sshd runs it as the forced
# command of the nexus-ops keys:
#   main key (owner approves each run):  sudo -n /usr/local/sbin/nexus-ops-runner "$SSH_ORIGINAL_COMMAND"
#   check key (no per-run approval):     sudo -n /usr/local/sbin/nexus-ops-runner --check "$SSH_ORIGINAL_COMMAND"
# In check mode a request is accepted only if BOTH hold:
#   - the operation and argument are one of the read-only checks in check_allowed below (part of
#     this file, so changing it means installing a new runner on the server), and
#   - the exact script (its SHA-256) is listed for that operation in /etc/nexus-ops/trusted-checks,
#     a root-owned file written only by the owner-approved operation "trust-checks apply".
# So the check key can never run code the owner has not approved once.
#
# Request (one argument):  run <operation> <argument|-> <script-sha256> <commit> <github-run-id>
# The script itself arrives on stdin. It must match the SHA-256 shown on the GitHub approval page.
#
# It runs one script at a time, detached from the SSH connection (a dropped connection does not
# stop it), with a time limit. It keeps every script it ran and its full output under
# /var/lib/nexus-ops and /var/log/nexus-ops. Off switch: sudo touch /etc/nexus-ops/disabled
set -u
umask 077
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH
LC_ALL=C
export LC_ALL

BASE=/var/lib/nexus-ops/state
LOGDIR=/var/log/nexus-ops
DISABLED=/etc/nexus-ops/disabled
TRUSTED=/etc/nexus-ops/trusted-checks
MAX_BYTES=524288
TIME_LIMIT=1800
UPLOAD_LIMIT=120

say() { printf '%s\n' "$*"; }
refuse() { say "nexus-ops: refused: $*"; exit 3; }
matches() { printf '%s' "$1" | grep -Eqx -- "$2"; }
now() { date -u +%Y-%m-%dT%H:%M:%SZ; }

# The read-only checks the check key may start (operation and argument; "-" means none).
# Keep identical to ops/vps/check-operations.txt (a test compares them).
check_allowed() {
    case "$1 $2" in
        "hello -" | "staging-inventory show" | "staging-config-check show" | "staging-backup status" | \
        "pa-backup status" | "staging-pa-off-check measure" | "staging-pa-off-stop check" | \
        "staging-pa-off-stop verify" | "p1b-stop-staging check" | "p1b-stop-staging verify") return 0 ;;
        "ops-log "*) matches "$2" '[0-9]{1,20}' ;;
        *) return 1 ;;
    esac
}

mode=approved
if [ "${1:-}" = --check ]; then mode=check; shift; fi
[ "$(id -u)" = 0 ] || refuse "must run as root (through sudo)"
[ -e "$DISABLED" ] && refuse "operations are switched off on this server ($DISABLED exists)"
[ "$#" = 1 ] || refuse "expected exactly one request argument"
matches "$1" '[A-Za-z0-9 ._-]{1,200}' || refuse "request contains characters that are not allowed"

set -f
# shellcheck disable=SC2086  # deliberate split of the validated request
set -- $1
set +f
[ "$#" = 6 ] && [ "$1" = run ] || refuse "expected: run <operation> <argument|-> <sha256> <commit> <run-id>"
op=$2 arg=$3 want=$4 commit=$5 run_id=$6
matches "$op" '[a-z0-9][a-z0-9-]{0,40}' || refuse "bad operation name"
[ "$arg" = - ] || matches "$arg" '[a-z0-9][a-z0-9-]{0,30}' || refuse "bad argument"
matches "$want" '[0-9a-f]{64}' || refuse "bad sha256"
matches "$commit" '[0-9a-f]{40}' || refuse "bad commit"
matches "$run_id" '[0-9]{1,20}' || refuse "bad run id"
if [ "$mode" = check ]; then
    check_allowed "$op" "$arg" || refuse "the check key may only start read-only checks; '$op ${arg#-}' needs the owner's approval"
fi

mkdir -p "$BASE/scripts" "$BASE/work/$op" "$LOGDIR/check"
chmod 700 "$BASE" "$LOGDIR" "$LOGDIR/check"

# Receive and verify the script BEFORE taking the one-at-a-time lock, with a time limit on the
# upload, so a request that never finishes sending cannot block other operations.
tmp=$(mktemp "$BASE/incoming.XXXXXX") || refuse "cannot create a temporary file"
if ! timeout "$UPLOAD_LIMIT" head -c $((MAX_BYTES + 1)) > "$tmp"; then
    rm -f "$tmp"; refuse "the script did not arrive within $UPLOAD_LIMIT seconds"
fi
size=$(stat -c %s "$tmp")
if [ "$size" -gt "$MAX_BYTES" ] || [ "$size" = 0 ]; then rm -f "$tmp"; refuse "script is empty or larger than $MAX_BYTES bytes"; fi
got=$(sha256sum "$tmp" | cut -d' ' -f1)
if [ "$got" != "$want" ]; then rm -f "$tmp"; refuse "script SHA-256 $got does not match the approved $want"; fi
if [ "$mode" = check ]; then
    if [ -z "$(find "$TRUSTED" -maxdepth 0 -type f -user 0 ! -perm /022 2>/dev/null)" ] \
        || ! grep -qxF "$op $got" "$TRUSTED"; then
        rm -f "$tmp"
        refuse "this exact $op script (${got%"${got#????????????}"}…) is not trusted for the check key; the owner approves it once with 'trust-checks apply'"
    fi
fi

exec 9>"$BASE/lock"
if ! flock -n 9; then rm -f "$tmp"; refuse "another operation is still running"; fi
script="$BASE/scripts/$got.sh"
mv -f "$tmp" "$script"

# Check-key runs keep their own records, so a check-key request can never use up the run id of an
# owner-approved run (the caller chooses the run id).
if [ "$mode" = check ]; then rec="$LOGDIR/check/$run_id-$op"; else rec="$LOGDIR/$run_id-$op"; fi
log="$rec.log"
rc_file="$rec.rc"
[ -e "$rc_file" ] && refuse "run $run_id of $op already happened; see $log"
: > "$log"
say "$(now) run=$run_id op=$op arg=$arg commit=$commit sha256=$got mode=$mode started" >> "$LOGDIR/runs.log"
say "nexus-ops: run $run_id: $op ${arg#-} (commit ${commit%"${commit#???????}"}, script ${got%"${got#????????????}"}…, $mode)"

# Detached: new session, no terminal, stdin closed. Exit code goes to $rc_file when it ends.
# The wrapper keeps the lock (fd 9) until the script ends; the script itself does not inherit it.
setsid sh -c '
    cd "$1" || exit 70
    if [ "$3" = - ]; then timeout --kill-after=30 "$4" sh "$2" 9>&-; else timeout --kill-after=30 "$4" sh "$2" "$3" 9>&-; fi \
        > "$5" 2>&1 < /dev/null
    rc=$?
    printf "%s\n" "$rc" > "$6.tmp" && mv -f "$6.tmp" "$6"
    printf "%s run=%s op=%s finished exit=%s\n" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$7" "$8" "$rc" >> "$9"
' nexus-op "$BASE/work/$op" "$script" "$arg" "$TIME_LIMIT" "$log" "$rc_file" "$run_id" "$op" "$LOGDIR/runs.log" \
    < /dev/null > /dev/null 2>&1 &
exec 9>&-

# Stream the log back to GitHub until the script finishes.
sent=0
deadline=$(( $(date +%s) + TIME_LIMIT + 90 ))
while :; do
    done_now=0
    [ -s "$rc_file" ] && done_now=1
    size=$(stat -c %s "$log" 2>/dev/null || echo 0)
    if [ "$size" -gt "$sent" ]; then
        tail -c +$((sent + 1)) "$log" | head -c $((size - sent))
        sent=$size
    fi
    [ "$done_now" = 1 ] && break
    if [ "$(date +%s)" -gt "$deadline" ]; then say "nexus-ops: still running after the time limit; see $log"; exit 4; fi
    sleep 1
done
rc=$(cat "$rc_file")
say "nexus-ops: finished with exit code $rc (full log on the server: $log)"
exit "$rc"
