# Copy to .env.guardian (ignored by Git) and replace every placeholder.
# Do not put HUB_CONTROL_KEY, exchange credentials, or live-routing settings here.
GUARDIAN_READ_KEY=REPLACE_WITH_INDEPENDENT_RANDOM_32_BYTE_READ_KEY
GUARDIAN_SOURCE_KEYS_JSON='{"guardian_probe":"REPLACE_WITH_INDEPENDENT_RANDOM_32_BYTE_SOURCE_KEY"}'
GUARDIAN_REQUIRED_COMPONENTS=guardian,guardian_incident_engine,guardian_public_probe,api,instance_ledger,instance_market_data,trading_instances,pa_lab,smc_lab
# Optional bounded lab-decision observer. Set the matching
# HUB_GUARDIAN_OBSERVER_KEY in the app's protected environment. The value must
# be independent of all control, webhook, exchange, Guardian read/source keys.
# GUARDIAN_LAB_OBSERVER_URL=http://app:8000/guardian/observations
# GUARDIAN_LAB_OBSERVER_KEY=REPLACE_WITH_INDEPENDENT_RANDOM_32_BYTE_OBSERVER_KEY
