# Copy to .env and replace every CHANGE_ME value with a unique secret.
# Customer accounts use Supabase Auth. HUB_USERNAME/HUB_PASSWORD are only a
# disabled-by-default break-glass recovery mechanism, never a customer login.
HUB_AUTH_MODE=supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=CHANGE_ME_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME_SUPABASE_SERVICE_ROLE_KEY_SERVER_ONLY
# Existing ledger compatibility uses this server-only key as well. It is never
# exposed in browser JavaScript; RLS-protected customer calls use the anon key.
SUPABASE_KEY=CHANGE_ME_SUPABASE_SERVICE_ROLE_KEY_SERVER_ONLY
HUB_AUTH_GOOGLE_ENABLED=0
HUB_AUTH_APPLE_ENABLED=0
# Emergency recovery only. Do not enable in normal operation.
HUB_EMERGENCY_ADMIN_ENABLED=0
HUB_USERNAME=emergency-admin
HUB_PASSWORD=CHANGE_ME_BREAK_GLASS_PASSWORD
HUB_SECRET=CHANGE_ME_64_RANDOM_CHARACTERS
HUB_WEBHOOK_SECRET=CHANGE_ME_A_DIFFERENT_WEBHOOK_SECRET
HUB_CONTROL_KEY=CHANGE_ME_A_DIFFERENT_CONTROL_KEY
# Exchange credentials are a separate namespace and are never accepted by the
# app control or TradingView webhook endpoints.
HUB_EXCHANGE_API_KEY=CHANGE_ME_EXCHANGE_API_KEY
HUB_EXCHANGE_API_SECRET=CHANGE_ME_EXCHANGE_API_SECRET
# Master key for the encrypted exchange-key vault (Settings -> Security ->
# Exchange keys). 32 random bytes, base64. Until it is set the vault refuses to
# store any key. Keep a copy somewhere safe: without it stored keys cannot be
# read (they can be attached again). To change it, re-wrap the vault first:
#   python -m services.key_vault rewrap   (inside the app container)
# Generate one with:
#   python -c "import base64,secrets;print(base64.b64encode(secrets.token_bytes(32)).decode())"
HUB_MASTER_KEY=CHANGE_ME_BASE64_32_BYTES
# The same master key also seals the nightly backups (DATA_DIR/backups/*.tlxb).
# Restore one with:  python -m services.backup restore <snapshot> <folder>
# Optional: send every new audit-log entry to storage you control (a log
# collector or SIEM intake that accepts JSON Lines). https:// only.
HUB_AUDIT_EXPORT_URL=
HUB_AUDIT_EXPORT_TOKEN=
HUB_AUDIT_EXPORT_INTERVAL=900
HUB_ORDER_STATE_DB=/var/lib/tradexa/execution_orders.db
# Keep real venue routing disabled until the testnet soak and live approval gate.
HUB_ENABLE_EXTERNAL_LIVE=0
HUB_CORS_ORIGINS=https://trade-logx.com,https://www.trade-logx.com
# Legacy autonomous engine only. Production Paper Trading is controlled by
# Trading Instances, so keep this disabled unless exercising legacy diagnostics.
HUB_AUTO_ENGINE=0
# Shadow PA/SMC research observer is opt-in; keep it off on a small VPS.
HUB_RESEARCH_AUTOSTART=0
# How often each lab supervisor re-evaluates, in seconds. Each SMC tick
# rebuilds a market structure engine over an 800-bar window, while on a 5m
# timeframe a new closed candle only appears every 300s, so the default spends
# most of its work recomputing an unchanged result. Raise these on a small
# host: 30 still evaluates ten times per 5m candle at a fraction of the CPU.
HUB_SMC_POLL=5
HUB_PA_POLL=5
# V2 can only observe closed paper-engine bars. Keep off until observations
# are reviewed; 'shadow' records evidence but cannot execute trades.
HUB_CORE_V2_MODE=off
# Production paper validation must use forward market data. If the provider is
# unavailable, the engine reports the degraded feed and does not invent trades.
HUB_USE_LIVE_DATA=1
HUB_EXCHANGE=kraken
# Conservative paper-validation limits. These do not enable real execution.
HUB_MAX_DAILY_LOSS=0.01
HUB_MAX_DRAWDOWN=0.10
HUB_MAX_CONSEC_LOSSES=3
HUB_COOLDOWN_MIN=60
HUB_EXPOSURE_LIMIT=0.05
HUB_STARTING_CASH=10000
# Do not judge a future live proposal on ideal fills. This remains paper-only,
# but models spread, slippage, fees, partial fills, and rejected orders.
HUB_FILL_MODEL=realistic
HUB_FILL_SPREAD_PCT=0.0004
HUB_FILL_SLIPPAGE_PCT=0.0003
HUB_FILL_LATENCY_PCT=0.0001
HUB_FILL_PARTIAL_PROB=0.0
HUB_FILL_PARTIAL_FRACTION=0.6
HUB_FILL_REJECT_PROB=0.0
HUB_FILL_TAKER_FEE_PCT=0.0004
HUB_FILL_MAKER_FEE_PCT=0.0002
HUB_FILL_RANDOM_SEED=1
# Reduce only new-entry risk when a symbol's measured paper record degrades.
# It never alters exits or increases risk; set 0 only for controlled A/B research.
HUB_STRATEGY_HEALTH_GUARD=1
# Adaptive MTF Trend Pullback v1.0.0. Trading Instances expose it only on the
# 5m decision clock; these thresholds apply to newly started workers.
HUB_ATP_FAST_EMA=20
HUB_ATP_SLOW_EMA=50
HUB_ATP_ADX_PERIOD=14
HUB_ATP_ADX_MIN=20
HUB_ATP_REGIME_CONFIDENCE_MIN=70
HUB_ATP_TREND_CONFIDENCE_MIN=70
HUB_ATP_QUALITY_MINIMUM=75
HUB_ATP_MINIMUM_RR=2.0
HUB_ATP_TARGET_RR=2.5
HUB_ATP_ATR_PERIOD=14
HUB_ATP_STOP_ATR_BUFFER=0.25
HUB_ATP_MAXIMUM_ATR_PCT=0.04
HUB_ATP_MAXIMUM_ATR_EXPANSION=2.0
HUB_ATP_MAXIMUM_EXTENSION_ATR=3.0
HUB_ATP_EMA_SEPARATION_MIN_ATR=0.10
HUB_ATP_STRUCTURE_LOOKBACK=30
HUB_ATP_PULLBACK_LOOKBACK=20
HUB_ATP_CONFIRMATION_LOOKBACK=8
HUB_ATP_ABNORMAL_VOLUME_MULTIPLE=2.5
HUB_ATP_CONFIRMATION_VOLUME_MULTIPLE=1.15
HUB_ATP_REJECTION_WICK_BODY_RATIO=1.5
HUB_ATP_CORRECTIVE_MOVE_ATR=0.5
HUB_ATP_PULLBACK_ZONE_ATR=0.80
HUB_ATP_TARGET_METHOD=fixed_rr
# Paper Trading V2 (strict provider candles only; no synthetic price fallback)
# Leave paths under the persistent Docker volume (HUB_DATA_DIR) in production.
HUB_MARKET_DATA_DIR=/app/data/market_data
HUB_PAPER_BROKER_V2_DB=/app/data/paper_broker_v2.db
# Per-instance learned adjustments are isolated JSON state under the durable
# Docker data volume. Do not point this at an ephemeral container path.
HUB_INSTANCE_LEARNING_DIR=/var/lib/tradexa/instance-learning
# Native SMC remains research-only. Leave this unset until a verified visual
# review checkpoint is generated outside the repository and copied into the
# persistent Docker volume. It never creates a trading worker or order path.
# HUB_SMC_VISUAL_CHECKPOINT_PATH=/var/lib/tradexa/native-smc-review/smc_native_v1_btcusdt_5m_2025-03.checkpoint.json
# HUB_SMC_VISUAL_REVIEW_PATH=/var/lib/tradexa/native-smc-review/reviews.json
# Set to 1 only after downloading the required V2 history. This routes the
# shared historical-data facade used by AI/replay/simulation/backtests to the
# strict V2 cache and disables legacy development fallbacks for every consumer.
HUB_MARKET_DATA_V2=1
