# Keep the image lean. The dashboard SOURCE is needed (the Docker UI stage
# builds it), but its node_modules / dist / env are not.
.git
**/node_modules
**/dist
automation-hub-dashboard/.env
automation-hub-dashboard/.env.*
**/__pycache__
*.egg-info
**/*.db
.pytest_cache
report.html

# Secrets reach the container at run time through compose's env_file. They
# must never be copied into an image layer by the `COPY . .` in the Dockerfile.
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
