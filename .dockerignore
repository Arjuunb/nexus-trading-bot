# Keep the image lean. The dashboard SOURCE is needed (the Docker UI stage
# builds it), but its node_modules / dist / env are not.
.git
# Compose injects runtime credentials. Never bake dotenv files or local state
# into an image; the landing receives public auth config from the API at runtime.
.env*
**/.env*
.venv
**/.venv
automation-hub/logs
**/node_modules
**/dist
automation-hub-dashboard/.env
automation-hub-dashboard/.env.*
**/__pycache__
*.egg-info
**/*.db
**/*.sqlite
**/*.sqlite3
**/*.db-wal
**/*.db-shm
**/*.sqlite-wal
**/*.sqlite-shm
.pytest_cache
report.html

# Secrets reach the container at run time through compose's env_file. They
# must never be copied into an image layer by the `COPY . .` in the Dockerfile.
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Generated research history stays outside release contexts, including copies.
**/strategy_v2_research_ledger.jsonl
**/strategy_v2_verdict_ledger.jsonl
**/strategy_v3_research_ledger.jsonl
